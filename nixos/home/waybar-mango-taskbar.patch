+Taskbar::Taskbar(const std::string& id, const Bar& bar, const Json::Value& config)
+    : AModule(config, "taskbar", id, false, false), bar_(bar), box_(bar.orientation, 0) {
+  box_.set_name("taskbar");
+  if (!id.empty()) box_.get_style_context()->add_class(id);
+  box_.get_style_context()->add_class(MODULE_CLASS);
+  box_.get_style_context()->add_class("empty");
+  box_.get_style_context()->add_class("disconnected");
+  event_box_.add(box_);
+
+  if (config_["all-outputs"].isBool()) all_outputs_ = config_["all-outputs"].asBool();
+  if (config_["format"].isString()) format_ = config_["format"].asString();
+  if (config_["tooltip-format"].isString()) {
+    tooltip_format_ = config_["tooltip-format"].asString();
+  }
+  if (config_["on-click"].isString()) on_click_left_ = config_["on-click"].asString();
+  if (config_["on-click-middle"].isString()) {
+    on_click_middle_ = config_["on-click-middle"].asString();
+  }
+  if (config_["on-click-right"].isString()) {
+    on_click_right_ = config_["on-click-right"].asString();
+  }
+
+  const auto is_builtin_action = [](const std::string& action) {
+    return action == "activate" || action == "close" || action == "minimize";
+  };
+  for (const auto* event : {"on-click", "on-click-middle", "on-click-right"}) {
+    if (config_[event].isString() && is_builtin_action(config_[event].asString())) {
+      eventActionMap_.insert({event, config_[event].asString()});
+    }
+  }
+
+  IPC::getInstance().registerForIPC("clients", this);
+  dp.emit();
+}
