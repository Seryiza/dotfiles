diff --git a/include/modules/mango/taskbar_model.hpp b/include/modules/mango/taskbar_model.hpp
new file mode 100644
index 0000000..ece947e
--- /dev/null
+++ b/include/modules/mango/taskbar_model.hpp
@@ -0,0 +1,118 @@
+#pragma once
+
+#include <json/value.h>
+
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace waybar::modules::mango {
+
+using ClientId = std::uint32_t;
+
+struct ClientInfo {
+  ClientId id = 0;
+  std::string title;
+  std::string app_id;
+  std::string monitor;
+  bool visible = false;
+  bool focused = false;
+  bool fullscreen = false;
+  bool maximized = false;
+  bool minimized = false;
+  bool urgent = false;
+};
+
+struct ClientSnapshot {
+  std::uint64_t generation = 0;
+  std::vector<ClientInfo> clients;
+  std::unordered_map<ClientId, std::size_t> index_by_id;
+};
+
+struct ClientCache {
+  std::shared_ptr<const ClientSnapshot> snapshot;
+  std::uint64_t generation = 0;
+  bool connected = false;
+  bool fresh = false;
+
+  bool actionable(ClientId id, std::uint64_t rendered_generation) const {
+    // Mango's current dispatch parser narrows explicit IDs through signed int.
+    // Keep larger uint32 identities visible, but never send an ambiguous action.
+    return id <= static_cast<ClientId>(std::numeric_limits<int>::max()) && connected && fresh &&
+           snapshot && generation == rendered_generation && snapshot->generation == generation &&
+           snapshot->index_by_id.contains(id);
+  }
+};
+
+inline std::optional<ClientSnapshot> parseClientSnapshot(const Json::Value& root,
+                                                         std::uint64_t generation,
+                                                         std::string* error = nullptr) {
+  const auto fail = [error](const std::string& message) -> std::optional<ClientSnapshot> {
+    if (error != nullptr) *error = message;
+    return std::nullopt;
+  };
+
+  if (!root.isObject() || !root.isMember("clients") || !root["clients"].isArray()) {
+    return fail("root must contain a clients array");
+  }
+
+  ClientSnapshot snapshot;
+  snapshot.generation = generation;
+  snapshot.clients.reserve(root["clients"].size());
+
+  for (const auto& value : root["clients"]) {
+    if (!value.isObject()) return fail("each client must be an object");
+
+    const auto& id = value["id"];
+    if (!id.isUInt64() || id.asUInt64() == 0 ||
+        id.asUInt64() > std::numeric_limits<ClientId>::max()) {
+      return fail("client id must be a non-zero uint32");
+    }
+
+    for (const auto* field : {"title", "appid", "monitor"}) {
+      if (!value[field].isString())
+        return fail(std::string("client field '") + field + "' must be a string");
+    }
+    for (const auto* field : {"is_visible", "is_focused", "is_fullscreen", "is_maximized",
+                              "is_minimized", "is_urgent"}) {
+      if (!value[field].isBool())
+        return fail(std::string("client field '") + field + "' must be a boolean");
+    }
+
+    ClientInfo client;
+    client.id = static_cast<ClientId>(id.asUInt64());
+    client.title = value["title"].asString();
+    client.app_id = value["appid"].asString();
+    client.monitor = value["monitor"].asString();
+    client.visible = value["is_visible"].asBool();
+    client.focused = value["is_focused"].asBool();
+    client.fullscreen = value["is_fullscreen"].asBool();
+    client.maximized = value["is_maximized"].asBool();
+    client.minimized = value["is_minimized"].asBool();
+    client.urgent = value["is_urgent"].asBool();
+
+    const auto index = snapshot.clients.size();
+    if (!snapshot.index_by_id.emplace(client.id, index).second) {
+      return fail("client ids must be unique");
+    }
+    snapshot.clients.push_back(std::move(client));
+  }
+
+  return snapshot;
+}
+
+inline std::vector<ClientId> visibleClientIds(const ClientSnapshot& snapshot,
+                                              const std::string& output, bool all_outputs = false) {
+  std::vector<ClientId> result;
+  for (const auto& client : snapshot.clients) {
+    if (client.visible && (all_outputs || client.monitor == output)) result.push_back(client.id);
+  }
+  return result;
+}
+
+}  // namespace waybar::modules::mango
