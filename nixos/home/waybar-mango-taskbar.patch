+
+void IPC::runCommandIPC() {
+  while (running_) {
+    PendingCommand pending;
+    {
+      std::unique_lock<std::mutex> lock(command_mutex_);
+      command_condition_.wait(lock, [this]() { return !running_ || !command_queue_.empty(); });
+      if (!running_) break;
+      pending = std::move(command_queue_.front());
+      command_queue_.pop_front();
+    }
+
+    try {
+      IPC::sendCommand(pending.command, pending.id, pending.generation, &command_sockfd_);
+    } catch (const std::exception& e) {
+      spdlog::error("Mango IPC async command failed: {}", e.what());
+    }
+  }
+}
+
+void IPC::enqueueCommand(const std::string& command, ClientId id, std::uint64_t generation) {
+  try {
+    startCommandIPC();
+  } catch (const std::exception& e) {
+    spdlog::error("Failed to start Mango IPC command thread: {}", e.what());
+    return;
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(command_mutex_);
+    if (!running_) return;
+    if (command_queue_.size() >= kMaxPendingCommands) {
+      spdlog::warn("Dropping Mango IPC command: command queue is full");
+      return;
+    }
+    command_queue_.push_back({command, id, generation});
+  }
+  command_condition_.notify_one();
+}
+
+void IPC::runClientsIPC() {
+  spdlog::info("Mango clients IPC thread started");
+  char buf[4096];
+
+  while (running_) {
+    int fd = -1;
+    SocketIdentity socket_identity;
+    try {
+      fd = IPC::connectToSocket(&socket_identity);
+      clients_sockfd_ = fd;
+    } catch (const std::exception& e) {
+      spdlog::error("Mango clients IPC: failed to connect: {}", e.what());
+      std::this_thread::sleep_for(std::chrono::seconds(2));
+      continue;
+    }
+
+    if (!running_) {
+      closeOwnedFd(clients_sockfd_, fd);
+      break;
+    }
+    if (!writeAll(fd, "watch all-clients\n")) {
+      spdlog::error("Failed to subscribe to watch all-clients");
+      closeOwnedFd(clients_sockfd_, fd);
+      std::this_thread::sleep_for(std::chrono::seconds(2));
+      continue;
+    }
+
+    const auto generation = setClientsConnected(socket_identity);
+    struct pollfd pfd = {.fd = fd, .events = POLLIN, .revents = 0};
+    std::string buffer;
+    bool connected = true;
+
+    while (running_ && connected) {
+      const auto ret = poll(&pfd, 1, 1000);
+      if (ret == 0) continue;
+      if (ret < 0) {
+        if (errno == EINTR) continue;
+        spdlog::error("Mango clients IPC poll error: {}", strerror(errno));
+        break;
+      }
+      if (pfd.revents & (POLLERR | POLLHUP | POLLNVAL)) break;
+      if (!(pfd.revents & POLLIN)) continue;
+
+      const auto n = read(fd, buf, sizeof(buf));
+      if (n == 0) break;
+      if (n < 0) {
+        if (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK) continue;
+        spdlog::error("Mango clients IPC read error: {}", strerror(errno));
+        break;
+      }
+      buffer.append(buf, n);
+
+      std::size_t pos;
+      while ((pos = buffer.find('\n')) != std::string::npos) {
+        std::string line = buffer.substr(0, pos);
+        buffer.erase(0, pos + 1);
+        if (line.empty()) continue;
+        if (line.size() > kMaxIPCFrameSize || !parseClientsIPC(line, generation)) {
+          connected = false;
+          break;
+        }
+      }
+      if (buffer.size() > kMaxIPCFrameSize) {
+        spdlog::warn("Mango clients IPC frame exceeded {} bytes", kMaxIPCFrameSize);
+        connected = false;
+      }
+    }
+
+    closeOwnedFd(clients_sockfd_, fd);
+    if (!running_) break;
+    setClientsDisconnected(generation);
+    spdlog::warn("Mango clients IPC stream closed, reconnecting");
+    std::this_thread::sleep_for(std::chrono::seconds(2));
+  }
+
+  spdlog::info("Mango clients IPC thread stopping");
+}
