+bool IPC::parseClientsIPC(const std::string& line, std::uint64_t generation) {
+  Json::Value root;
+  Json::CharReaderBuilder builder;
+  std::string errors;
+  std::istringstream iss(line);
+  if (!Json::parseFromStream(builder, iss, &root, &errors)) {
+    spdlog::warn("Failed to parse Mango clients IPC JSON: {}", errors);
+    return false;
+  }
+
+  auto parsed = parseClientSnapshot(root, generation, &errors);
+  if (!parsed) {
+    spdlog::warn("Rejected Mango clients IPC snapshot: {}", errors);
+    return false;
+  }
+
+  auto snapshot = std::make_shared<ClientSnapshot>(std::move(*parsed));
+  {
+    std::lock_guard<std::mutex> lock(client_cache_mutex_);
+    if (client_cache_.generation != generation || !client_cache_.connected) return false;
+    client_cache_.snapshot = std::move(snapshot);
+    client_cache_.fresh = true;
+  }
+  notify("clients", root);
+  return true;
+}
+
+std::uint64_t IPC::setClientsConnected(const SocketIdentity& identity) {
+  std::uint64_t generation;
+  {
+    std::lock_guard<std::mutex> lock(client_cache_mutex_);
+    generation = ++client_cache_.generation;
+    client_cache_.connected = true;
+    client_cache_.fresh = false;
+    clients_socket_identity_ = identity;
+  }
+  notify("clients");
+  return generation;
+}
+
+void IPC::setClientsDisconnected(std::uint64_t generation) {
+  {
+    std::lock_guard<std::mutex> lock(client_cache_mutex_);
+    if (client_cache_.generation != generation) return;
+    client_cache_.connected = false;
+    client_cache_.fresh = false;
+  }
+  notify("clients");
+}
+
+bool IPC::clientCommandActionable(ClientId id, std::uint64_t generation,
+                                  const SocketIdentity& identity) const {
+  std::lock_guard<std::mutex> lock(client_cache_mutex_);
+  return clients_socket_identity_ == identity && client_cache_.actionable(id, generation);
+}
+
+void IPC::notify(const std::string& event, const Json::Value& payload) {
+  std::lock_guard<std::mutex> lock(callback_mutex_);
+  for (auto& [registered_event, handler] : callbacks_) {
+    if (registered_event == event) handler->onEvent(payload);
+  }
+}
