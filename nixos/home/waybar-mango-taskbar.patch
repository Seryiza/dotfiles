new file mode 100644
index 0000000..510616f
--- /dev/null
+++ b/man/waybar-mango-taskbar.5.scd
@@ -0,0 +1,115 @@
+waybar-mango-taskbar(5)
+
+# NAME
+
+waybar - Mango taskbar module
+
+# DESCRIPTION
+
+The *mango/taskbar* module displays Mango clients visible on the selected tags. Client identity and ordering come directly from Mango's *watch all-clients* IPC snapshots, so windows with identical titles and application IDs remain distinct.
+
+# CONFIGURATION
+
+Addressed by *mango/taskbar*
+
+*format*: ++
+	typeof: string ++
+	default: {title} ++
+	The format for each client button. See *FORMAT REPLACEMENTS*.
+
+*all-outputs*: ++
+	typeof: bool ++
+	default: false ++
+	If false, only visible clients on the bar's output are shown. If true, visible clients from every output are shown.
+
+*justify*: ++
+	typeof: string ++
+	default: center ++
+	The button-label alignment. Supported values are *left*, *center*, and *right*.
+
+*truncate*: ++
+	typeof: bool ++
+	default: false ++
+	Ellipsizes labels that do not fit in the available space.
+
+*markup*: ++
+	typeof: bool ++
+	default: false ++
+	If true, formatted labels and tooltips are interpreted as Pango markup. Client-provided fields are escaped before formatting.
+
+*rewrite*: ++
+	typeof: object ++
+	Rules for rewriting formatted labels and tooltips.
+
+*tooltip*: ++
+	typeof: bool ++
+	default: true ++
+	Enables client tooltips.
+
+*tooltip-format*: ++
+	typeof: string ++
+	default: {title} ++
+	The tooltip format. Supports the same replacements as *format*.
+
+*on-click*: ++
+	typeof: string ++
+	Action for left click. Supported actions are *activate*, *close*, and *minimize*.
+
+*on-click-middle*: ++
+	typeof: string ++
+	Action for middle click. Supports the same actions as *on-click*.
+
+*on-click-right*: ++
+	typeof: string ++
+	Action for right click. Supports the same actions as *on-click*.
+
+# FORMAT REPLACEMENTS
+
+*{title}*: Client title.
+
+*{app_id}*: Client application ID.
+
+*{id}*: Mango client ID.
+
+*{state}*: Space-separated active states: *minimized*, *maximized*, *active*, *fullscreen*, and *urgent*.
+
+# CLICK ACTIONS
+
+*activate* dispatches *focusid* to the button's Mango client ID.
+
+*close* dispatches *killclient* to the button's Mango client ID.
+
+*minimize* dispatches *minimized* to the button's Mango client ID.
+
+Mango currently falls back to the focused client if an explicitly targeted client disappears before *close* or *minimize* is processed. This creates a small stale-ID race for those two actions. *activate* fails closed when its target no longer exists. Buttons remain visible but disabled if their ID exceeds Mango's current signed dispatch-parser range.
+
+# IPC RECOVERY
+
+The module shares one *watch all-clients* stream with all Mango taskbar instances in the Waybar process. During a disconnect, the last complete snapshot remains visible, the module receives the *disconnected* CSS class, and every client button is disabled. Buttons are rebuilt and re-enabled only after a complete snapshot for the new connection generation.
+
+The module consumes watch events without periodic polling. Rare inactive-title and ordering changes that Mango does not announce appear after the next all-client event.
+
+# EXAMPLES
+
+```
+"mango/taskbar": {
+	"format": "{title}",
+	"justify": "left",
+	"truncate": true,
+	"tooltip-format": "{title}",
+	"on-click": "activate",
+	"on-click-middle": "close",
+	"on-click-right": "minimize"
+}
+```
+
+# STYLE
+
+- *#taskbar*
+- *#taskbar.empty*
+- *#taskbar.disconnected*
+- *#taskbar button.active*
+- *#taskbar button.urgent*
+- *#taskbar button.minimized*
+- *#taskbar button.maximized*
+- *#taskbar button.fullscreen*
