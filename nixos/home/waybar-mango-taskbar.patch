+void Taskbar::update() {
+  reconcile(IPC::getInstance().getClientCache());
+  AModule::update();
+}
+
+void Taskbar::reconcile(const ClientCache& cache) {
+  const bool fresh = cache.connected && cache.fresh && cache.snapshot &&
+                     cache.snapshot->generation == cache.generation;
+  setClass(box_.get_style_context(), "disconnected", !fresh);
+
+  if (!cache.snapshot) {
+    setClass(box_.get_style_context(), "empty", true);
+    return;
+  }
+
+  // Keep the previous generation visible but inert while reconnecting. Numeric
+  // Mango IDs may be reused after a compositor restart, so only reconcile once
+  // a complete snapshot for the new generation has arrived.
+  if (cache.snapshot->generation != cache.generation) {
+    for (auto& [id, task] : tasks_) task->button.set_sensitive(false);
+    return;
+  }
+
+  if (rendered_generation_ != cache.generation) {
+    clearTasks();
+    rendered_generation_ = cache.generation;
+  }
+
+  std::unordered_set<ClientId> present;
+  present.reserve(cache.snapshot->clients.size());
+  std::size_t visible_count = 0;
+
+  for (const auto& client : cache.snapshot->clients) {
+    present.insert(client.id);
+    auto it = tasks_.find(client.id);
+    auto& task = it == tasks_.end() ? addTask(client.id, cache.generation) : *it->second;
+    updateTask(task, client, cache.actionable(client.id, task.generation));
+
+    const bool visible = client.visible && (all_outputs_ || client.monitor == bar_.output->name);
+    if (visible) {
+      task.button.show_all();
+      ++visible_count;
+    } else {
+      task.button.hide();
+    }
+  }
+
+  for (auto it = tasks_.begin(); it != tasks_.end();) {
+    if (!present.contains(it->first)) {
+      box_.remove(it->second->button);
+      it = tasks_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+
+  int position = 0;
+  for (const auto& client : cache.snapshot->clients) {
+    box_.reorder_child(tasks_.at(client.id)->button, position++);
+  }
+  setClass(box_.get_style_context(), "empty", visible_count == 0);
+}
+
+Taskbar::Task& Taskbar::addTask(ClientId id, std::uint64_t generation) {
+  auto task = std::make_unique<Task>(id, generation);
+  auto& result = *task;
+
+  result.button.set_relief(Gtk::RELIEF_NONE);
+  result.button.set_hexpand(true);
+  result.label.set_halign(Gtk::ALIGN_FILL);
+  result.label.set_hexpand(true);
+  result.label.set_single_line_mode(true);
+
+  float alignment = 0.5F;
+  if (config_["justify"].isString()) {
+    const auto justify = config_["justify"].asString();
+    if (justify == "left")
+      alignment = 0.0F;
+    else if (justify == "right")
+      alignment = 1.0F;
+    else if (justify != "center")
+      spdlog::warn("Invalid mango/taskbar justify: expected left, center, or right");
+  }
+  result.label.set_xalign(alignment);
+
+  if (config_["truncate"].isBool() && config_["truncate"].asBool()) {
+    result.label.set_line_wrap(false);
+    result.label.set_ellipsize(Pango::ELLIPSIZE_END);
+  }
+
+  result.button.add(result.label);
+  result.button.add_events(Gdk::BUTTON_RELEASE_MASK);
+  result.button.signal_button_release_event().connect(
+      [this, id](GdkEventButton* event) { return handleButtonClick(event, id); }, false);
+  box_.pack_start(result.button, false, false, 0);
+
+  const auto insertion = tasks_.emplace(id, std::move(task));
+  return *insertion.first->second;
+}
+
+void Taskbar::clearTasks() {
+  for (auto& [id, task] : tasks_) box_.remove(task->button);
+  tasks_.clear();
+}
+
+void Taskbar::updateTask(Task& task, const ClientInfo& client, bool actionable) {
+  auto text = formatText(format_, client);
+  text = waybar::util::rewriteString(text, config_["rewrite"]);
+  if (config_["markup"].isBool() && config_["markup"].asBool())
+    task.label.set_markup(text);
+  else
+    task.label.set_text(text);
+
+  if (tooltipEnabled()) {
+    auto tooltip = formatText(tooltip_format_, client);
+    tooltip = waybar::util::rewriteString(tooltip, config_["rewrite"]);
+    if (config_["markup"].isBool() && config_["markup"].asBool())
+      task.button.set_tooltip_markup(tooltip);
+    else
+      task.button.set_tooltip_text(tooltip);
+  } else {
+    task.button.set_has_tooltip(false);
+  }
+
+  const auto style = task.button.get_style_context();
+  setClass(style, "active", client.focused);
+  setClass(style, "urgent", client.urgent);
+  setClass(style, "minimized", client.minimized);
+  setClass(style, "maximized", client.maximized);
+  setClass(style, "fullscreen", client.fullscreen);
+  task.button.set_sensitive(actionable);
+
+  const auto accessible = task.button.get_accessible();
+  if (accessible) accessible->set_name(client.title);
+}
+
+bool Taskbar::handleButtonClick(GdkEventButton* event, ClientId id) {
+  std::string action;
+  if (event->button == 1)
+    action = on_click_left_;
+  else if (event->button == 2)
+    action = on_click_middle_;
+  else if (event->button == 3)
+    action = on_click_right_;
+
+  auto task = tasks_.find(id);
+  const auto cache = IPC::getInstance().getClientCache();
+  if (task == tasks_.end() || !cache.actionable(id, task->second->generation)) return true;
+
+  std::string command;
+  if (action == "activate")
+    command = fmt::format("dispatch focusid client,{}", id);
+  else if (action == "close")
+    command = fmt::format("dispatch killclient client,{}", id);
+  else if (action == "minimize")
+    command = fmt::format("dispatch minimized client,{}", id);
+  else
+    return false;
+
+  Json::Value request;
+  request["command"] = command;
+  IPC::getInstance().sendClientCommandAsync(request, id, task->second->generation);
+  return true;
+}
+
+std::string Taskbar::formatText(const std::string& format, const ClientInfo& client) const {
+  const bool markup = config_["markup"].isBool() && config_["markup"].asBool();
+  const std::string title = markup ? Glib::Markup::escape_text(client.title).raw() : client.title;
+  const std::string app_id =
+      markup ? Glib::Markup::escape_text(client.app_id).raw() : client.app_id;
+
+  try {
+    return fmt::format(fmt::runtime(format), fmt::arg("title", title), fmt::arg("app_id", app_id),
+                       fmt::arg("id", client.id), fmt::arg("state", stateString(client)));
+  } catch (const fmt::format_error& error) {
+    spdlog::warn("Failed to format mango/taskbar text '{}': {}", format, error.what());
+    return title;
+  }
+}
+
+std::string Taskbar::stateString(const ClientInfo& client) {
+  std::string state;
+  for (const auto& [enabled, name] : {
+           std::pair{client.minimized, "minimized"},
+           std::pair{client.maximized, "maximized"},
+           std::pair{client.focused, "active"},
+           std::pair{client.fullscreen, "fullscreen"},
+           std::pair{client.urgent, "urgent"},
+       }) {
+    if (!enabled) continue;
+    if (!state.empty()) state += ' ';
+    state += name;
+  }
+  return state;
+}
+
+void Taskbar::setClass(const Glib::RefPtr<Gtk::StyleContext>& style, const std::string& name,
+                       bool enabled) {
+  if (enabled)
+    style->add_class(name);
+  else
+    style->remove_class(name);
+}
+
+}  // namespace waybar::modules::mango
