+  const auto options = parseWorkspacesOptions(config_);
+  if (options.orientation == "horizontal") {
+    box_.set_orientation(Gtk::ORIENTATION_HORIZONTAL);
+  } else if (options.orientation == "vertical") {
+    box_.set_orientation(Gtk::ORIENTATION_VERTICAL);
+  } else if (options.orientation_invalid) {
+    spdlog::warn("Invalid mango/workspaces orientation: expected horizontal or vertical");
+  }
+
+  if (options.height) {
+    box_.set_size_request(-1, *options.height);
+  } else if (options.height_invalid) {
+    spdlog::warn("Invalid mango/workspaces height: expected a non-negative integer");
+  }
+
+  homogeneous_ = options.homogeneous;
+  if (options.homogeneous_invalid) {
+    spdlog::warn("Invalid mango/workspaces homogeneous: expected a boolean");
+  }
+  box_.set_homogeneous(homogeneous_);
+
