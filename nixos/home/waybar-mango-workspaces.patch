@@ -0,0 +1,48 @@
+#pragma once
+
+#include <json/value.h>
+
+#include <optional>
+#include <string>
+
+namespace waybar::modules::mango {
+
+struct WorkspacesOptions {
+  std::string orientation;
+  bool orientation_invalid = false;
+  std::optional<int> height;
+  bool height_invalid = false;
+  bool homogeneous = false;
+  bool homogeneous_invalid = false;
+};
+
+inline WorkspacesOptions parseWorkspacesOptions(const Json::Value& config) {
+  WorkspacesOptions options;
+
+  const auto& orientation = config["orientation"];
+  if (orientation.isString()) {
+    options.orientation = orientation.asString();
+    options.orientation_invalid =
+        options.orientation != "horizontal" && options.orientation != "vertical";
+  } else if (!orientation.isNull()) {
+    options.orientation_invalid = true;
+  }
+
+  const auto& height = config["height"];
+  if (height.isInt() && height.asInt() >= 0) {
+    options.height = height.asInt();
+  } else if (!height.isNull()) {
+    options.height_invalid = true;
+  }
+
+  const auto& homogeneous = config["homogeneous"];
+  if (homogeneous.isBool()) {
+    options.homogeneous = homogeneous.asBool();
+  } else if (!homogeneous.isNull()) {
+    options.homogeneous_invalid = true;
+  }
+
+  return options;
+}
+
+}  // namespace waybar::modules::mango
