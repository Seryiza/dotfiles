diff --git a/test/mango-taskbar-widget.cpp b/test/mango-taskbar-widget.cpp
new file mode 100644
index 0000000..b3673e2
--- /dev/null
+++ b/test/mango-taskbar-widget.cpp
@@ -0,0 +1,129 @@
+#if __has_include(<catch2/catch_test_macros.hpp>)
+#include <catch2/catch_test_macros.hpp>
+#else
+#include <catch2/catch.hpp>
+#endif
+
+#include <gtkmm/main.h>
+#include <gtkmm/window.h>
+
+#include <string>
+
+#include "modules/mango/taskbar_widget.hpp"
+
+namespace mango = waybar::modules::mango;
+
+namespace {
+
+void initializeGtk() {
+  static Gtk::Main gtk;
+}
+
+void flushGtkEvents() {
+  while (Gtk::Main::events_pending()) Gtk::Main::iteration();
+}
+
+int requestedWidth(Gtk::Widget& widget) {
+  int width = 0;
+  int height = 0;
+  widget.get_size_request(width, height);
+  return width;
+}
+
+struct LabelFixture {
+  explicit LabelFixture(int width)
+      : sizer(Gtk::ORIENTATION_HORIZONTAL, 0), content(Gtk::ORIENTATION_HORIZONTAL, 0) {
+    title.set_hexpand(true);
+    content.pack_start(title, true, true, 0);
+    has_slot = mango::setupTaskbarAppLabelSlot(content, sizer, app_label, slot, width);
+  }
+
+  Gtk::Label title;
+  Gtk::Box sizer;
+  Gtk::Label app_label;
+  Gtk::Overlay slot;
+  Gtk::Box content;
+  bool has_slot = false;
+};
+
+void realizeInWindow(LabelFixture& fixture, int width = 160) {
+  Gtk::Window window;
+  window.set_default_size(width, 30);
+  window.add(fixture.content);
+  window.show_all();
+  flushGtkEvents();
+
+  REQUIRE(fixture.slot.get_allocated_width() == requestedWidth(fixture.sizer));
+  REQUIRE(fixture.app_label.get_allocated_width() == fixture.slot.get_allocated_width());
+
+  window.remove();
+  flushGtkEvents();
+}
+
+}  // namespace
+
+TEST_CASE("Mango taskbar app label slot keeps fixed GTK geometry", "[mango][taskbar][gtk]") {
+  initializeGtk();
+
+  SECTION("positive width reserves an empty unmatched suffix") {
+    LabelFixture fixture(28);
+    const mango::TaskbarOptions options;
+    mango::ClientInfo client;
+    client.app_id = "unmatched.app";
+
+    mango::updateTaskbarLabels(fixture.title, fixture.app_label, Json::Value(Json::objectValue),
+                               options, client, "Window title");
+
+    REQUIRE(fixture.has_slot);
+    REQUIRE(requestedWidth(fixture.sizer) == 28);
+    REQUIRE(fixture.app_label.get_text().empty());
+    realizeInWindow(fixture);
+  }
+
+  SECTION("zero width suppresses the suffix widget") {
+    LabelFixture fixture(0);
+
+    REQUIRE_FALSE(fixture.has_slot);
+    REQUIRE(fixture.slot.get_parent() == nullptr);
+    REQUIRE(fixture.content.get_children().size() == 1);
+  }
+
+  SECTION("long labels stay inside the fixed slot and ellipsize") {
+    LabelFixture fixture(28);
+    Json::Value config(Json::objectValue);
+    const std::string long_label = "A very long application label";
+    config["app-labels"]["org.example.LongApp"] = long_label;
+    const auto options = mango::parseTaskbarOptions(config);
+    mango::ClientInfo client;
+    client.app_id = "org.example.LongApp";
+
+    mango::updateTaskbarLabels(fixture.title, fixture.app_label, config, options, client,
+                               "Window title");
+
+    REQUIRE(fixture.app_label.get_text() == long_label);
+    REQUIRE(fixture.app_label.get_ellipsize() == Pango::ELLIPSIZE_END);
+    realizeInWindow(fixture);
+  }
+}
+
+TEST_CASE("Mango taskbar app ID mapping stays literal and title-only rules stay isolated",
+          "[mango][taskbar][gtk]") {
+  initializeGtk();
+
+  Json::Value config(Json::objectValue);
+  config["markup"] = true;
+  config["rewrite"]["^Original title$"] = "<i>Rewritten title</i>";
+  config["app-labels"]["org.example.App"] = "<b>APP & literal</b>";
+  const auto options = mango::parseTaskbarOptions(config);
+  mango::ClientInfo client;
+  client.app_id = "org.example.App";
+
+  LabelFixture fixture(28);
+  mango::updateTaskbarLabels(fixture.title, fixture.app_label, config, options, client,
+                             "Original title");
+
+  REQUIRE(fixture.title.get_use_markup());
+  REQUIRE(fixture.title.get_text() == "Rewritten title");
+  REQUIRE_FALSE(fixture.app_label.get_use_markup());
+  REQUIRE(fixture.app_label.get_text() == "<b>APP & literal</b>");
+}
