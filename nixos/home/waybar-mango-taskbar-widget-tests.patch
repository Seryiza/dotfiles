+#pragma once
+
+#include <gtkmm/box.h>
+#include <gtkmm/label.h>
+#include <gtkmm/overlay.h>
+#include <json/value.h>
+
+#include <string>
+
+#include "modules/mango/taskbar_model.hpp"
+#include "util/rewrite_string.hpp"
+
+namespace waybar::modules::mango {
+
+inline bool setupTaskbarAppLabelSlot(Gtk::Box& content, Gtk::Box& sizer, Gtk::Label& label,
+                                     Gtk::Overlay& slot, int width) {
+  if (width <= 0) return false;
+
+  sizer.set_size_request(width, -1);
+  slot.add(sizer);
+  label.get_style_context()->add_class("app-label");
+  label.set_halign(Gtk::ALIGN_FILL);
+  label.set_valign(Gtk::ALIGN_FILL);
+  label.set_single_line_mode(true);
+  label.set_ellipsize(Pango::ELLIPSIZE_END);
+  slot.add_overlay(label);
+  content.pack_end(slot, false, false, 0);
+  return true;
+}
+
+inline void updateTaskbarLabels(Gtk::Label& title_label, Gtk::Label& app_label,
+                                const Json::Value& config, const TaskbarOptions& options,
+                                const ClientInfo& client, std::string title) {
+  title = waybar::util::rewriteString(title, config["rewrite"]);
+  if (config["markup"].isBool() && config["markup"].asBool())
+    title_label.set_markup(title);
+  else
+    title_label.set_text(title);
+
+  // App labels are presentation metadata, not title markup. Keep the exact
+  // configured value literal and isolate it from title rewrite rules.
+  app_label.set_text(appLabelFor(options, client.app_id));
+}
+
+}  // namespace waybar::modules::mango
