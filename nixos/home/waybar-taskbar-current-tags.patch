+#ifdef HAVE_MANGO
+  if (config_["mango-current-tags-only"].asBool()) {
+    try {
+      Json::Value request;
+      request["command"] = "get all-clients";
+      const auto response = waybar::modules::mango::IPC::send(request);
+      const auto& clients = response["clients"];
+      if (!clients.isArray()) {
+        throw std::runtime_error("Mango IPC returned no clients array");
+      }
+      std::vector<bool> claimed(clients.size(), false);
+
+      const auto apply_visibility = [&](TaskPtr& task) {
+        bool visible = false;
+        const int passes = task->active() ? 2 : 1;
+        for (int pass = 0; pass < passes && !visible; ++pass) {
+          for (Json::ArrayIndex i = 0; i < clients.size(); ++i) {
+            const auto& client = clients[i];
+            const bool require_focused = task->active() && pass == 0;
+            if (claimed[i] || !client["is_visible"].asBool() ||
+                (require_focused && !client["is_focused"].asBool()) ||
+                client["monitor"].asString() != bar_.output->name ||
+                client["title"].asString() != task->title() ||
+                client["appid"].asString() != task->app_id()) {
+              continue;
+            }
+            claimed[i] = true;
+            visible = true;
+            break;
+          }
+        }
+        task->set_filter_visible(visible);
+      };
+
+      // Claim the focused Mango client for the active foreign-toplevel first.
+      for (auto& task : tasks_) {
+        if (task->active()) apply_visibility(task);
+      }
+      for (auto& task : tasks_) {
+        if (!task->active()) apply_visibility(task);
+      }
+    } catch (const std::exception& e) {
+      spdlog::warn("Failed to filter taskbar using Mango IPC: {}", e.what());
+      for (auto& task : tasks_) {
+        task->set_filter_visible(false);
+      }
+    }
+  }
+#endif
