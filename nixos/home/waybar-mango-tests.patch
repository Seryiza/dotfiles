--- /dev/null
+++ b/test/mango.cpp
@@ -0,0 +1,228 @@
+#if __has_include(<catch2/catch_test_macros.hpp>)
+#include <catch2/catch_test_macros.hpp>
+#else
+#include <catch2/catch.hpp>
+#endif
+
+#include <limits>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "modules/mango/taskbar_model.hpp"
+#include "modules/mango/workspaces_options.hpp"
+
+namespace mango = waybar::modules::mango;
+
+namespace {
+
+Json::Value makeClient(Json::UInt64 id, const std::string& title = "Terminal",
+                       const std::string& app_id = "Alacritty",
+                       const std::string& monitor = "eDP-1", bool visible = true,
+                       bool focused = false, bool urgent = false) {
+  Json::Value client(Json::objectValue);
+  client["id"] = id;
+  client["title"] = title;
+  client["appid"] = app_id;
+  client["monitor"] = monitor;
+  client["is_visible"] = visible;
+  client["is_focused"] = focused;
+  client["is_fullscreen"] = false;
+  client["is_maximized"] = false;
+  client["is_minimized"] = false;
+  client["is_urgent"] = urgent;
+  return client;
+}
+
+Json::Value makeSnapshot(std::initializer_list<Json::Value> clients) {
+  Json::Value root(Json::objectValue);
+  root["clients"] = Json::Value(Json::arrayValue);
+  for (const auto& client : clients) root["clients"].append(client);
+  return root;
+}
+
+std::shared_ptr<const mango::ClientSnapshot> parsedSnapshot(const Json::Value& root,
+                                                            std::uint64_t generation) {
+  auto parsed = mango::parseClientSnapshot(root, generation);
+  if (!parsed) throw std::runtime_error("test fixture produced an invalid snapshot");
+  return std::make_shared<mango::ClientSnapshot>(std::move(*parsed));
+}
+
+}  // namespace
+
+TEST_CASE("Mango taskbar keys duplicate applications by client ID", "[mango][taskbar]") {
+  const auto snapshot = parsedSnapshot(
+      makeSnapshot({makeClient(42), makeClient(7), makeClient(99, "Editor", "Emacs")}), 3);
+
+  REQUIRE(snapshot->clients.size() == 3);
+  REQUIRE(snapshot->clients[0].id == 42);
+  REQUIRE(snapshot->clients[1].id == 7);
+  REQUIRE(snapshot->index_by_id.at(42) == 0);
+  REQUIRE(snapshot->index_by_id.at(7) == 1);
+  REQUIRE(snapshot->clients[0].title == snapshot->clients[1].title);
+  REQUIRE(snapshot->clients[0].app_id == snapshot->clients[1].app_id);
+}
+
+TEST_CASE("Mango taskbar preserves snapshot order across focus changes", "[mango][taskbar]") {
+  auto first = makeSnapshot({makeClient(40), makeClient(10, "B"), makeClient(70, "C")});
+  first["clients"][1]["is_focused"] = true;
+  auto second = first;
+  second["clients"][1]["is_focused"] = false;
+  second["clients"][2]["is_focused"] = true;
+
+  const auto before = parsedSnapshot(first, 1);
+  const auto after = parsedSnapshot(second, 1);
+  REQUIRE(mango::visibleClientIds(*before, "eDP-1") == std::vector<mango::ClientId>{40, 10, 70});
+  REQUIRE(mango::visibleClientIds(*after, "eDP-1") == std::vector<mango::ClientId>{40, 10, 70});
+  REQUIRE(after->clients[2].focused);
+}
+
+TEST_CASE("Mango taskbar filters selected-tag visibility and output", "[mango][taskbar]") {
+  const auto snapshot =
+      parsedSnapshot(makeSnapshot({makeClient(10, "one", "app", "eDP-1", true),
+                                   makeClient(20, "two", "app", "eDP-1", false),
+                                   makeClient(30, "three", "app", "HDMI-A-1", true)}),
+                     2);
+
+  REQUIRE(mango::visibleClientIds(*snapshot, "eDP-1") == std::vector<mango::ClientId>{10});
+  REQUIRE(mango::visibleClientIds(*snapshot, "eDP-1", true) ==
+          std::vector<mango::ClientId>{10, 30});
+}
+
+TEST_CASE("Mango taskbar preserves urgency transitions", "[mango][taskbar]") {
+  auto calm = makeClient(42);
+  auto urgent = calm;
+  urgent["is_urgent"] = true;
+  auto cleared = urgent;
+  cleared["is_urgent"] = false;
+
+  const auto before = parsedSnapshot(makeSnapshot({calm}), 4);
+  const auto during = parsedSnapshot(makeSnapshot({urgent}), 4);
+  const auto after = parsedSnapshot(makeSnapshot({cleared}), 4);
+
+  REQUIRE_FALSE(before->clients[0].urgent);
+  REQUIRE(during->clients[0].urgent);
+  REQUIRE_FALSE(after->clients[0].urgent);
+}
+
+TEST_CASE("Mango client snapshots validate identity and required fields", "[mango][taskbar]") {
+  SECTION("an empty snapshot is authoritative") {
+    const auto snapshot = mango::parseClientSnapshot(makeSnapshot({}), 8);
+    REQUIRE(snapshot.has_value());
+    REQUIRE(snapshot->clients.empty());
+    REQUIRE(snapshot->index_by_id.empty());
+  }
+
+  SECTION("zero IDs are rejected") {
+    REQUIRE_FALSE(mango::parseClientSnapshot(makeSnapshot({makeClient(0)}), 1).has_value());
+  }
+
+  SECTION("IDs above uint32 are rejected") {
+    const auto too_large =
+        static_cast<Json::UInt64>(std::numeric_limits<mango::ClientId>::max()) + 1;
+    REQUIRE_FALSE(mango::parseClientSnapshot(makeSnapshot({makeClient(too_large)}), 1).has_value());
+  }
+
+  SECTION("the maximum uint32 ID is visible but cannot target Mango's signed parser") {
+    const auto maximum = std::numeric_limits<mango::ClientId>::max();
+    const auto snapshot = parsedSnapshot(makeSnapshot({makeClient(maximum)}), 1);
+    mango::ClientCache cache{snapshot, 1, true, true};
+    REQUIRE(snapshot->index_by_id.contains(maximum));
+    REQUIRE_FALSE(cache.actionable(maximum, 1));
+  }
+
+  SECTION("duplicate IDs reject the whole snapshot") {
+    REQUIRE_FALSE(
+        mango::parseClientSnapshot(makeSnapshot({makeClient(5), makeClient(5, "other")}), 1)
+            .has_value());
+  }
+
+  SECTION("missing and mistyped fields are rejected") {
+    auto missing = makeClient(5);
+    missing.removeMember("monitor");
+    REQUIRE_FALSE(mango::parseClientSnapshot(makeSnapshot({missing}), 1).has_value());
+
+    auto wrong_type = makeClient(5);
+    wrong_type["is_visible"] = "yes";
+    REQUIRE_FALSE(mango::parseClientSnapshot(makeSnapshot({wrong_type}), 1).has_value());
+
+    auto wrong_urgency = makeClient(5);
+    wrong_urgency["is_urgent"] = "yes";
+    REQUIRE_FALSE(mango::parseClientSnapshot(makeSnapshot({wrong_urgency}), 1).has_value());
+  }
+
+  SECTION("the root must contain an array") {
+    Json::Value root(Json::objectValue);
+    root["clients"] = "not an array";
+    REQUIRE_FALSE(mango::parseClientSnapshot(root, 1).has_value());
+  }
+}
+
+TEST_CASE("Mango taskbar actions require a fresh matching generation", "[mango][taskbar]") {
+  mango::ClientCache cache;
+  cache.snapshot = parsedSnapshot(makeSnapshot({makeClient(42)}), 7);
+  cache.generation = 7;
+  cache.connected = true;
+  cache.fresh = true;
+
+  REQUIRE(cache.actionable(42, 7));
+  REQUIRE_FALSE(cache.actionable(99, 7));
+  REQUIRE_FALSE(cache.actionable(42, 6));
+
+  SECTION("disconnect retains data but disables actions") {
+    cache.connected = false;
+    cache.fresh = false;
+    REQUIRE(cache.snapshot->index_by_id.contains(42));
+    REQUIRE_FALSE(cache.actionable(42, 7));
+  }
+
+  SECTION("a reconnect cannot make the old generation actionable") {
+    cache.generation = 8;
+    cache.fresh = false;
+    REQUIRE_FALSE(cache.actionable(42, 7));
+    REQUIRE_FALSE(cache.actionable(42, 8));
+  }
+
+  SECTION("only a new complete snapshot enables the generation") {
+    cache.generation = 8;
+    cache.snapshot = parsedSnapshot(makeSnapshot({makeClient(42, "new client")}), 8);
+    REQUIRE(cache.actionable(42, 8));
+    REQUIRE_FALSE(cache.actionable(42, 7));
+  }
+}
+
+TEST_CASE("Mango workspace options validate types and ranges", "[mango][workspaces]") {
+  Json::Value config;
+  config["orientation"] = "horizontal";
+  config["height"] = 20;
+  config["homogeneous"] = true;
+
+  const auto valid = mango::parseWorkspacesOptions(config);
+  REQUIRE(valid.orientation == "horizontal");
+  REQUIRE_FALSE(valid.orientation_invalid);
+  REQUIRE(valid.height == 20);
+  REQUIRE(valid.homogeneous);
+  REQUIRE_FALSE(valid.homogeneous_invalid);
+
+  Json::Value invalid;
+  invalid["orientation"] = "diagonal";
+  invalid["height"] = -1;
+  invalid["homogeneous"] = "yes";
+
+  const auto rejected = mango::parseWorkspacesOptions(invalid);
+  REQUIRE(rejected.orientation_invalid);
+  REQUIRE_FALSE(rejected.height.has_value());
+  REQUIRE(rejected.height_invalid);
+  REQUIRE_FALSE(rejected.homogeneous);
+  REQUIRE(rejected.homogeneous_invalid);
+}
+
+TEST_CASE("Mango workspace height rejects values above int range", "[mango][workspaces]") {
+  Json::Value config;
+  config["height"] = Json::UInt{std::numeric_limits<Json::UInt>::max()};
+
+  const auto options = mango::parseWorkspacesOptions(config);
+  REQUIRE_FALSE(options.height.has_value());
+  REQUIRE(options.height_invalid);
+}
