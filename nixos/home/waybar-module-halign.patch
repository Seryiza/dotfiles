diff --git a/man/waybar.5.scd.in b/man/waybar.5.scd.in
index ff2af1b..0677966 100644
--- a/man/waybar.5.scd.in
+++ b/man/waybar.5.scd.in
@@ -81,0 +82,6 @@ The visual display elements for waybar use a CSS stylesheet. Waybar supports *st
+*modules-right-halign* ++
+	typeof: string ++
+	default: fill ++
+	Sets the horizontal alignment of each module in *modules-right*. ++
+	Possible values are *start*, *center*, *end*, and *fill*.
+
diff --git a/src/bar.cpp b/src/bar.cpp
index ec3189c..3e8ffc2 100644
--- a/src/bar.cpp
+++ b/src/bar.cpp
@@ -673,0 +674,23 @@ auto waybar::Bar::setupWidgets() -> void {
+  bool apply_right_halign = false;
+  Gtk::Align right_halign = Gtk::ALIGN_FILL;
+  const auto& right_halign_config = config["modules-right-halign"];
+  if (right_halign_config.isString()) {
+    const auto value = right_halign_config.asString();
+    if (value == "start") {
+      right_halign = Gtk::ALIGN_START;
+      apply_right_halign = true;
+    } else if (value == "center") {
+      right_halign = Gtk::ALIGN_CENTER;
+      apply_right_halign = true;
+    } else if (value == "end") {
+      right_halign = Gtk::ALIGN_END;
+      apply_right_halign = true;
+    } else if (value == "fill") {
+      apply_right_halign = true;
+    } else {
+      spdlog::warn("Invalid modules-right-halign: expected start, center, end, or fill");
+    }
+  } else if (!right_halign_config.isNull()) {
+    spdlog::warn("Invalid modules-right-halign: expected a string");
+  }
+
@@ -676 +699,5 @@ auto waybar::Bar::setupWidgets() -> void {
-    right_.pack_end(*module, module->expandEnabled(), module->expandEnabled());
+    Gtk::Widget& widget = *module;
+    if (apply_right_halign) {
+      widget.set_halign(right_halign);
+    }
+    right_.pack_end(widget, module->expandEnabled(), module->expandEnabled());
