+static void applyModuleHalign(Gtk::Widget& widget, const Json::Value& config,
+                              const std::string& option) {
+  if (config.isNull()) {
+    return;
+  }
+  if (!config.isString()) {
+    spdlog::warn("Invalid {}: expected start, center, end, or fill", option);
+    return;
+  }
+
+  const auto value = config.asString();
+  if (value == "start") {
+    widget.set_halign(Gtk::ALIGN_START);
+  } else if (value == "center") {
+    widget.set_halign(Gtk::ALIGN_CENTER);
+  } else if (value == "end") {
+    widget.set_halign(Gtk::ALIGN_END);
+  } else if (value == "fill") {
+    widget.set_halign(Gtk::ALIGN_FILL);
+  } else {
+    spdlog::warn("Invalid {}: expected start, center, end, or fill", option);
+  }
+}
