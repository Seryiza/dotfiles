diff --git a/src/modules/sni/tray.cpp b/src/modules/sni/tray.cpp
index 285c103..48a2d4d 100644
--- a/src/modules/sni/tray.cpp
+++ b/src/modules/sni/tray.cpp
@@ -10,0 +11,21 @@ namespace waybar::modules::SNI {
+namespace {
+
+Gtk::Orientation getTrayOrientation(const Bar& bar, const Json::Value& config) {
+  const auto& orientation = config["orientation"];
+  if (orientation.isNull()) {
+    return bar.orientation;
+  }
+  if (orientation.isString()) {
+    if (orientation.asString() == "horizontal") {
+      return Gtk::ORIENTATION_HORIZONTAL;
+    }
+    if (orientation.asString() == "vertical") {
+      return Gtk::ORIENTATION_VERTICAL;
+    }
+  }
+  spdlog::warn("Invalid tray orientation: expected horizontal or vertical");
+  return bar.orientation;
+}
+
+}  // namespace
