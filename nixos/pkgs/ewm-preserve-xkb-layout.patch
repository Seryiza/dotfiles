+#[test]
+fn layout_switch_survives_keyboard_capture_and_key_release() {
+    use ewm_core::input::{DeviceType, InputConfigEntry};
+
+    const KEY_SPACE: u32 = 57 + 8;
+
+    for capture in [false, true] {
+        let mut h = Harness::new();
+        h.focus(if capture {
+            FocusMode::EmbeddedApp
+        } else {
+            FocusMode::EmacsBuffer
+        });
+        h.fix.configure_input(vec![InputConfigEntry {
+            device_type: Some(DeviceType::Keyboard),
+            xkb_layouts: Some("us,ru".into()),
+            xkb_options: Some("grp:ctrl_space_toggle".into()),
+            ..Default::default()
+        }]);
+        h.chord(KEY_LEFTCTRL, KEY_SPACE, KeyboardAction::Forward);
+        assert_eq!(h.fix.ewm_ref().xkb_current_layout, 1);
+        if capture {
+            h.bindings(&[META_X])
+                .chord(KEY_LEFTALT, KEY_X, KeyboardAction::RedirectToEmacs)
+                .expect_capture(true)
+                .expect_keyboard_focus(Target::Emacs);
+        }
+        h.pump();
+        h.emacs.drain_events();
+        h.fix.enable_event_capture();
+
+        // Plain typing must preserve Russian before and after switching.
+        h.tap(KEY_A, KeyboardAction::Forward);
+        assert_eq!(h.fix.ewm_ref().xkb_current_layout, 1);
+        for expected in [0, 1, 0] {
+            h.chord(KEY_LEFTCTRL, KEY_SPACE, KeyboardAction::Forward);
+            assert_eq!(
+                h.fix.ewm_ref().xkb_current_layout, expected,
+                "Ctrl+Space was undone with capture={capture}",
+            );
+            h.tap(KEY_A, KeyboardAction::Forward);
+            assert_eq!(h.fix.ewm_ref().xkb_current_layout, expected);
+            h.pump();
+            let groups: Vec<_> = h
+                .emacs
+                .drain_events()
+                .into_iter()
+                .filter_map(|event| match event {
+                    ClientEvent::KeyboardModifiers { group, .. } => Some(group),
+                    _ => None,
+                })
+                .collect();
+            assert_eq!(groups.last().copied(), Some(expected as u32));
+            let layouts: Vec<_> = h
+                .fix
+                .drain_events()
+                .into_iter()
+                .filter_map(|event| match event {
+                    ewm_core::event::Event::LayoutSwitched { index, .. } => Some(index),
+                    _ => None,
+                })
+                .collect();
+            assert_eq!(layouts, vec![expected]);
+        }
+        h.clear_capture();
+    }
+}
