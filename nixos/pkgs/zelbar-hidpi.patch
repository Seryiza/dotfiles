diff --git a/src/Scale.zig b/src/Scale.zig
new file mode 100644
index 0000000..ae7e700
--- /dev/null
+++ b/src/Scale.zig
@@ -0,0 +1,51 @@
+const std = @import("std");
+
+pub const Size = struct {
+    width: u31,
+    height: u31,
+};
+
+pub const Factor = struct {
+    value: u31,
+
+    pub const one: Factor = .{ .value = 1 };
+
+    pub fn init(value: u31) !Factor {
+        if (value == 0) return error.InvalidScale;
+        return .{ .value = value };
+    }
+
+    pub fn physical(factor: Factor, comptime T: type, logical: T) !T {
+        const product = try std.math.mul(u31, @intCast(logical), factor.value);
+        return std.math.cast(T, product) orelse error.Overflow;
+    }
+
+    pub fn physical_size(factor: Factor, logical_width: u31, logical_height: u31) !Size {
+        return .{
+            .width = try factor.physical(u31, logical_width),
+            .height = try factor.physical(u31, logical_height),
+        };
+    }
+
+    pub fn font_attributes(factor: Factor, buffer: []u8) ![:0]u8 {
+        return std.fmt.bufPrintZ(buffer, "scale={d}", .{factor.value});
+    }
+};
+
+test "logical geometry maps to scaled physical buffers" {
+    const scale1 = try Factor.init(1);
+    const scale2 = try Factor.init(2);
+    try std.testing.expectEqual(Size{ .width = 400, .height = 20 }, try scale1.physical_size(400, 20));
+    try std.testing.expectEqual(Size{ .width = 800, .height = 40 }, try scale2.physical_size(400, 20));
+}
+
+test "fontconfig attributes use the output scale" {
+    var buffer: [32]u8 = undefined;
+    try std.testing.expectEqualStrings("scale=1", try Factor.one.font_attributes(&buffer));
+    try std.testing.expectEqualStrings("scale=2", try (try Factor.init(2)).font_attributes(&buffer));
+}
+
+test "zero and overflowing scales are rejected" {
+    try std.testing.expectError(error.InvalidScale, Factor.init(0));
+    try std.testing.expectError(error.Overflow, (try Factor.init(2)).physical(u16, std.math.maxInt(u16)));
+}
