+pub const VisiblePrefix = struct {
+    width: i32,
+    pen: i32,
+    glyph_count: usize,
+    ellipsis: ?*const fcft.Glyph = null,
+};
+
+fn fit_prefix(text: Text, max_width: i32) VisiblePrefix {
+    const glyphs = switch (text.mode) {
+        .run => text.mode.run.glyphs[0..text.mode.run.count],
+        .glyphs => text.mode.glyphs.glyphs,
+    };
+    var pen: i32 = 0;
+    var width: i32 = 0;
+    var count: usize = 0;
+
+    for (glyphs, 0..) |glyph, i| {
+        const glyph_x = pen + if (text.mode == .glyphs) @as(i32, @intCast(text.mode.glyphs.kerns[i])) else 0;
+        const next_pen = glyph_x + glyph.advance.x;
+        const ink_right = glyph_x + @as(i32, @intCast(glyph.x)) + @as(i32, @intCast(glyph.width));
+        const glyph_right = @max(next_pen, ink_right);
+        if (glyph_right > max_width) break;
+        pen = next_pen;
+        width = @max(width, glyph_right);
+        count += 1;
+    }
+
+    return .{ .width = @max(width, 0), .pen = pen, .glyph_count = count };
+}
+
+pub fn full_prefix(text: Text) VisiblePrefix {
+    const glyph_count = switch (text.mode) {
+        .run => text.mode.run.count,
+        .glyphs => text.mode.glyphs.glyphs.len,
+    };
+    return .{ .width = text.width, .pen = text.width, .glyph_count = glyph_count };
+}
+
+pub fn visible_prefix(text: Text, max_width: i32) !VisiblePrefix {
+    const visible = text.fit_prefix(max_width);
+    const glyph_count = switch (text.mode) {
+        .run => text.mode.run.count,
+        .glyphs => text.mode.glyphs.glyphs.len,
+    };
+    if (visible.glyph_count == glyph_count) return visible;
+
+    const ellipsis = try text.font.rasterizeCharUtf32(0x2026, .none);
+    const ellipsis_width = @max(
+        ellipsis.advance.x,
+        @as(i32, @intCast(ellipsis.x)) + @as(i32, @intCast(ellipsis.width)),
+    );
+    if (ellipsis_width > max_width) return .{ .width = 0, .pen = 0, .glyph_count = 0 };
+
+    var truncated = text.fit_prefix(max_width - ellipsis_width);
+    truncated.width = @max(truncated.width, truncated.pen + ellipsis_width);
+    truncated.ellipsis = ellipsis;
+    return truncated;
+}
